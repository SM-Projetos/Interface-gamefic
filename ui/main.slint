// Aba Criação de Conteúdo: catálogo de ferramentas de gravação, edição,
// áudio e comunicação — reutiliza AppCategory/AppCard e o modal global.
component ContentPage inherits Rectangle {
    in-out property <string> selected-app: "OBS Studio";
