import { ScrollView } from "std-widgets.slint";

// Fonte Inter embutida (SIL OFL 1.1 — ver assets/fonts/LICENSE-Inter-OFL.txt),
// garante pesos 400–800 independente das fontes do sistema.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/Inter-ExtraBold.ttf";

global Theme {
    in-out property <bool> dark-mode: true;

    out property <color> window-bg: dark-mode ? #061a32 : #ffffff;
    out property <brush> sidebar-bg: dark-mode
        ? @linear-gradient(180deg, #061a32 0%, #041329 100%)
        : @linear-gradient(180deg, #ffffff 0%, #f7fafe 100%);
    out property <color> topbar-bg: dark-mode ? #061a32 : #ffffff;
    out property <brush> page-bg: dark-mode
        ? @linear-gradient(18deg, #092d50 0%, #071d37 52%, #04162b 100%)
        : @linear-gradient(145deg, #ffffff 0%, #fbfdff 58%, #f3f9fe 100%);
    out property <brush> card-bg: dark-mode
        ? @linear-gradient(145deg, #0c2b49 0%, #08223e 58%, #071d36 100%)
        : @linear-gradient(145deg, #f3faff 0%, #e7f3fc 58%, #e2f0fb 100%);
    out property <brush> card-bg-highlight: dark-mode
        ? @linear-gradient(145deg, #124064 0%, #0b3153 58%, #082642 100%)
        : @linear-gradient(145deg, #e3f5ff 0%, #d7edfb 58%, #cce8f9 100%);
    out property <color> nav-hover: dark-mode ? #102e49 : #edf6fc;
    out property <color> card-border: dark-mode ? #1a3e5e : #d5e8f5;
    out property <color> separator: dark-mode ? #193552 : #e7eef4;
    out property <color> text-main: dark-mode ? #f4f8ff : #09295d;
    out property <color> text-muted: dark-mode ? #a8c6da : #35658c;
    out property <color> accent: dark-mode ? #16d3e8 : #0799df;
    out property <color> accent-deep: dark-mode ? #087fc7 : #087fd3;
    out property <color> active-menu: dark-mode ? #0796d4 : #1689e4;
    out property <color> status-installed: dark-mode ? #079fd0 : #168ee6;
    out property <color> status-not-installed: dark-mode ? #123b50 : #f8fcff;
    out property <color> status-not-installed-text: dark-mode ? #d5edf6 : #23638d;
}

// Card do catálogo, vindo do backend Rust (system/): id do REGISTRY resolve
// o ícone embutido (AppIcon) e `estado` carrega o estado real detectado —
// "instalado" | "nao_instalado" | "desconhecido" (nunca inventado).
struct AppInfo {
    id: string,
    name: string,
    description: string,
    estado: string,
    version: string,
    developer: string,
    source: string,
    has_update: bool,
}

// Dados do catálogo fornecidos pelo backend (detecção em thread de fundo,
// aplicada pela event loop do Slint). Enquanto `loaded` é falso, as páginas
// mostram o estado de carregamento; nenhum card exibe estado inventado.
export global CatalogData {
    in-out property <[AppInfo]> launchers: [];
    in-out property <[AppInfo]> emuladores: [];
    in-out property <[AppInfo]> tools: [];
    in-out property <[AppInfo]> compatibilidade: [];
    in-out property <[AppInfo]> criacao-gravacao: [];
    in-out property <[AppInfo]> criacao-video: [];
    in-out property <[AppInfo]> criacao-audio: [];
    in-out property <[AppInfo]> criacao-social: [];
    in-out property <bool> loaded: false;
    in-out property <string> status;
    in-out property <string> distro-name;
    // mensagem de resultado das ações da aba Apps, escrita pelo backend
    in-out property <string> acao-mensagem;
    callback abrir-app(string);
    callback acao-app(string, string);
    callback fontes-app(string);
}

// Estado compartilhado da janela de detalhes do catálogo: vive em escopo global
// para que o modal seja renderizado na MainWindow, centrado sobre a janela toda.
export global CatalogModal {
    in-out property <bool> open: false;
    in-out property <string> app-id;
    in-out property <string> name;
    in-out property <string> description;
    in-out property <string> estado;
    in-out property <string> category;
    in-out property <string> version;
    in-out property <string> developer;
    in-out property <string> source;
    in-out property <bool> has-update;

    // Abre a janela de detalhes com o contexto do cartão selecionado.
    public function open-from-app(app: AppInfo, app-category: string) {
        self.app-id = app.id;
        self.name = app.name;
        self.description = app.description;
        self.estado = app.estado;
        self.category = app-category;
        self.version = app.version;
        self.developer = app.developer;
        self.source = app.source;
        self.has-update = app.has_update;
        CatalogData.acao-mensagem = "Aplicativo: " + app.name + ". Ações executam no sistema real; a instalação pode pedir sua senha via pkexec.";
        self.open = true;
    }
}

component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <image> icon-image;
    in property <bool> active;
    in property <length> item-height: 52px;
    callback selected();

    height: item-height;
    border-radius: 14px;
    background: root.active ? Theme.active-menu : touch.has-hover ? Theme.nav-hover : #00000000;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        alignment: start;
        cross-axis-alignment: center;
        Image {
            source: root.icon-image;
            width: 22px;
            height: 22px;
            image-fit: contain;
            colorize: root.active ? #ffffff : Theme.text-main;
            vertical-alignment: center;
        }
        Text {

            font-family: "Inter";
            text: root.label;
            color: root.active ? #ffffff : Theme.text-main;
            font-size: 18px;
            font-weight: root.active ? 700 : 550;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        clicked => { root.selected(); }
    }
}

// Barra de título própria para a janela sem moldura: título centrado,
// botões de janela à direita e área de arraste pressionando o fundo da barra.
component TitleBarButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    callback pressed();

    width: 42px;
    height: 30px;
    border-radius: 8px;
    background: touch.has-hover ? (root.danger ? #d24b5a : Theme.nav-hover) : #00000000;

    Text {
        font-family: "Inter";
        text: root.glyph;
        color: touch.has-hover && root.danger ? #ffffff : Theme.text-main;
        font-size: 14px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.pressed(); }
    }
}

component TitleBar inherits Rectangle {
    callback minimize-requested();
    callback maximize-requested();
    callback close-requested();
    height: 42px;
    background: Theme.window-bg;
    accessible-role: window-title-bar;

    // duplo clique na barra (inclusive atrás dos textos) maximiza/restaura,
    // como um título nativo; o arrasto da janela continua pelo WindowMoveArea,
    // que não inicia move em clique simples e repassa o evento ao filho
    WindowMoveArea {
        TouchArea {
            double-clicked => { root.maximize-requested(); }
        }
    }

    Text {
        font-family: "Inter";
        text: "Gamefic";
        color: Theme.text-main;
        font-size: 15px;
        font-weight: 650;
        width: parent.width;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 176px;
        y: (parent.height - 30px) / 2;
        width: 34px;
        height: 30px;
        border-radius: 8px;
        background: settings-touch.has-hover ? Theme.nav-hover : #00000000;

        Image {
            source: @image-url("../assets/icons/settings.svg");
            width: 20px;
            height: 20px;
            image-fit: contain;
            colorize: Theme.text-main;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        settings-touch := TouchArea {
            clicked => { Theme.dark-mode = !Theme.dark-mode; }
        }
    }

    Rectangle {
        x: parent.width - 142px;
        y: (parent.height - 30px) / 2;
        width: 134px;
        height: 30px;

        HorizontalLayout {
            spacing: 4px;
            TitleBarButton {
                glyph: "–";
                pressed => { root.minimize-requested(); }
            }
            TitleBarButton {
                glyph: "□";
                pressed => { root.maximize-requested(); }
            }
            TitleBarButton {
                glyph: "✕";
                danger: true;
                pressed => { root.close-requested(); }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.separator;
    }
}

component Sidebar inherits Rectangle {
    in property <int> active-navigation: 0;
    callback navigation-selected(int);

    background: Theme.sidebar-bg;

    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 25px;
        padding-bottom: 17px;
        spacing: 22px;

        VerticalLayout {
            spacing: 8px;
            alignment: center;
            Image {
                source: @image-url("../assets/icons/gamefic.svg");
                width: 80px;
                height: 80px;
                image-fit: contain;
            }
            Text {

                font-family: "Inter";
                text: "Gamefic";
                color: Theme.text-main;
                font-size: 24px;
                font-weight: 750;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 8px;

            NavigationItem {
                label: "Apps";
                icon-image: @image-url("../assets/icons/nav-apps.svg");
                active: root.active-navigation == 0;
                selected => { root.navigation-selected(0); }
            }
            NavigationItem {
                label: "Criação de\nConteúdo";
                icon-image: @image-url("../assets/icons/nav-content.svg");
                item-height: 58px;
                active: root.active-navigation == 1;
                selected => { root.navigation-selected(1); }
            }
            NavigationItem {
                label: "Monitor";
                icon-image: @image-url("../assets/icons/nav-monitor.svg");
                active: root.active-navigation == 2;
                selected => { root.navigation-selected(2); }
            }
            NavigationItem {
                label: "Kernels e Drivers";
                icon-image: @image-url("../assets/icons/nav-drivers.svg");
                active: root.active-navigation == 3;
                selected => { root.navigation-selected(3); }
            }
            NavigationItem {
                label: "Otimização";
                icon-image: @image-url("../assets/icons/nav-optimization.svg");
                active: root.active-navigation == 4;
                selected => { root.navigation-selected(4); }
            }
            NavigationItem {
                label: "Overlay";
                icon-image: @image-url("../assets/icons/nav-overlay.svg");
                active: root.active-navigation == 5;
                selected => { root.navigation-selected(5); }
            }
            NavigationItem {
                label: "Histórico e\nDiagnósticos";
                icon-image: @image-url("../assets/icons/nav-history.svg");
                item-height: 58px;
                active: root.active-navigation == 6;
                selected => { root.navigation-selected(6); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #00000000;
        }

        Rectangle {
            height: 72px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.separator;
            background: Theme.dark-mode ? #071a31 : #ffffff;
            VerticalLayout {
                padding-left: 15px;
                padding-right: 10px;
                alignment: center;
                spacing: 3px;
                Text {

                    font-family: "Inter";
                    text: "Gamefic";
                    color: Theme.text-main;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {

                    font-family: "Inter";
                    text: "v0.1.0";
                    color: Theme.text-muted;
                    font-size: 13px;
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.separator;
    }
}

// Ícone do aplicativo resolvido pelo app-id do catálogo (portado do
// app-icon.slint do repo Gamefic): os assets ficam embutidos no binário
