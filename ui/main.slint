import { ScrollView } from "std-widgets.slint";

// Fonte Inter embutida (SIL OFL 1.1 — ver assets/fonts/LICENSE-Inter-OFL.txt),
// garante pesos 400–800 independente das fontes do sistema.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/Inter-ExtraBold.ttf";

global Theme {
    in-out property <bool> dark-mode: true;

    out property <color> window-bg: dark-mode ? #061a32 : #ffffff;
    out property <brush> sidebar-bg: dark-mode
        ? @linear-gradient(180deg, #061a32 0%, #041329 100%)
        : @linear-gradient(180deg, #ffffff 0%, #f7fafe 100%);
    out property <color> topbar-bg: dark-mode ? #061a32 : #ffffff;
    out property <brush> page-bg: dark-mode
        ? @linear-gradient(18deg, #092d50 0%, #071d37 52%, #04162b 100%)
        : @linear-gradient(145deg, #ffffff 0%, #fbfdff 58%, #f3f9fe 100%);
    out property <brush> card-bg: dark-mode
        ? @linear-gradient(145deg, #0c2b49 0%, #08223e 58%, #071d36 100%)
        : @linear-gradient(145deg, #f3faff 0%, #e7f3fc 58%, #e2f0fb 100%);
    out property <brush> card-bg-highlight: dark-mode
        ? @linear-gradient(145deg, #124064 0%, #0b3153 58%, #082642 100%)
        : @linear-gradient(145deg, #e3f5ff 0%, #d7edfb 58%, #cce8f9 100%);
    out property <color> nav-hover: dark-mode ? #102e49 : #edf6fc;
    out property <color> card-border: dark-mode ? #1a3e5e : #d5e8f5;
    out property <color> separator: dark-mode ? #193552 : #e7eef4;
    out property <color> text-main: dark-mode ? #f4f8ff : #09295d;
    out property <color> text-muted: dark-mode ? #a8c6da : #35658c;
    out property <color> accent: dark-mode ? #16d3e8 : #0799df;
    out property <color> accent-deep: dark-mode ? #087fc7 : #087fd3;
    out property <color> active-menu: dark-mode ? #0796d4 : #1689e4;
    out property <color> status-installed: dark-mode ? #079fd0 : #168ee6;
    out property <color> status-not-installed: dark-mode ? #123b50 : #f8fcff;
    out property <color> status-not-installed-text: dark-mode ? #d5edf6 : #23638d;
}

struct AppInfo {
    name: string,
    description: string,
    icon: image,
    installed: bool,
    version: string,
    developer: string,
    source: string,
    has_update: bool,
}

// Estado compartilhado da janela de detalhes do catálogo: vive em escopo global
// para que o modal seja renderizado na MainWindow, centrado sobre a janela toda.
global CatalogModal {
    in-out property <bool> open: false;
    in-out property <string> name;
    in-out property <string> description;
    in-out property <image> icon;
    in-out property <bool> installed;
    in-out property <string> category;
    in-out property <string> version;
    in-out property <string> developer;
    in-out property <string> source;
    in-out property <bool> has-update;
    in-out property <string> action-message: "Ações demonstrativas: o backend ainda não está conectado.";

    // Abre a janela de detalhes com o contexto do cartão selecionado.
    public function open-details(
        app-name: string,
        app-description: string,
        app-icon: image,
        app-installed: bool,
        app-category: string,
        app-version: string,
        app-developer: string,
        app-source: string,
        app-has-update: bool,
    ) {
        self.name = app-name;
        self.description = app-description;
        self.icon = app-icon;
        self.installed = app-installed;
        self.category = app-category;
        self.version = app-version;
        self.developer = app-developer;
        self.source = app-source;
        self.has-update = app-has-update;
        self.action-message = "Ações demonstrativas: nenhum comando do sistema é executado.";
        self.open = true;
    }
}

component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <image> icon-image;
    in property <bool> active;
    in property <length> item-height: 52px;
    callback selected();

    height: item-height;
    border-radius: 14px;
    background: root.active ? Theme.active-menu : touch.has-hover ? Theme.nav-hover : #00000000;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        alignment: start;
        cross-axis-alignment: center;
        Image {
            source: root.icon-image;
            width: 22px;
            height: 22px;
            image-fit: contain;
            colorize: root.active ? #ffffff : Theme.text-main;
            vertical-alignment: center;
        }
        Text {

            font-family: "Inter";
            text: root.label;
            color: root.active ? #ffffff : Theme.text-main;
            font-size: 18px;
            font-weight: root.active ? 700 : 550;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        clicked => { root.selected(); }
    }
}

// Barra de título própria para a janela sem moldura: título centrado,
// botões de janela à direita e área de arraste pressionando o fundo da barra.
component TitleBarButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    callback pressed();

    width: 42px;
    height: 30px;
    border-radius: 8px;
    background: touch.has-hover ? (root.danger ? #d24b5a : Theme.nav-hover) : #00000000;

    Text {
        font-family: "Inter";
        text: root.glyph;
        color: touch.has-hover && root.danger ? #ffffff : Theme.text-main;
        font-size: 14px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.pressed(); }
    }
}

component TitleBar inherits Rectangle {
    callback minimize-requested();
    callback maximize-requested();
    callback close-requested();
    height: 42px;
    background: Theme.window-bg;
    accessible-role: window-title-bar;

    WindowMoveArea { }

    Text {
        font-family: "Inter";
        text: "Gamefic";
        color: Theme.text-main;
        font-size: 15px;
        font-weight: 650;
        width: parent.width;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 176px;
        y: (parent.height - 30px) / 2;
        width: 34px;
        height: 30px;
        border-radius: 8px;
        background: settings-touch.has-hover ? Theme.nav-hover : #00000000;

        Image {
            source: @image-url("../assets/icons/settings.svg");
            width: 20px;
            height: 20px;
            image-fit: contain;
            colorize: Theme.text-main;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        settings-touch := TouchArea {
            clicked => { Theme.dark-mode = !Theme.dark-mode; }
        }
    }

    Rectangle {
        x: parent.width - 142px;
        y: (parent.height - 30px) / 2;
        width: 134px;
        height: 30px;

        HorizontalLayout {
            spacing: 4px;
            TitleBarButton {
                glyph: "–";
                pressed => { root.minimize-requested(); }
            }
            TitleBarButton {
                glyph: "□";
                pressed => { root.maximize-requested(); }
            }
            TitleBarButton {
                glyph: "✕";
                danger: true;
                pressed => { root.close-requested(); }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.separator;
    }
}

component Sidebar inherits Rectangle {
    in property <int> active-navigation: 0;
    callback navigation-selected(int);

    background: Theme.sidebar-bg;

    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 25px;
        padding-bottom: 17px;
        spacing: 22px;

        VerticalLayout {
            spacing: 8px;
            alignment: center;
            Image {
                source: @image-url("../assets/icons/gamefic.svg");
                width: 80px;
                height: 80px;
                image-fit: contain;
            }
            Text {

                font-family: "Inter";
                text: "Gamefic";
                color: Theme.text-main;
                font-size: 24px;
                font-weight: 750;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 8px;

            NavigationItem {
                label: "Apps";
                icon-image: @image-url("../assets/icons/nav-apps.svg");
                active: root.active-navigation == 0;
                selected => { root.navigation-selected(0); }
            }
            NavigationItem {
                label: "Criação de\nConteúdo";
                icon-image: @image-url("../assets/icons/nav-content.svg");
                item-height: 58px;
                active: root.active-navigation == 1;
                selected => { root.navigation-selected(1); }
            }
            NavigationItem {
                label: "Monitor";
                icon-image: @image-url("../assets/icons/nav-monitor.svg");
                active: root.active-navigation == 2;
                selected => { root.navigation-selected(2); }
            }
            NavigationItem {
                label: "Kernels e Drivers";
                icon-image: @image-url("../assets/icons/nav-drivers.svg");
                active: root.active-navigation == 3;
                selected => { root.navigation-selected(3); }
            }
            NavigationItem {
                label: "Otimização";
                icon-image: @image-url("../assets/icons/nav-optimization.svg");
                active: root.active-navigation == 4;
                selected => { root.navigation-selected(4); }
            }
            NavigationItem {
                label: "Overlay";
                icon-image: @image-url("../assets/icons/nav-overlay.svg");
                active: root.active-navigation == 5;
                selected => { root.navigation-selected(5); }
            }
            NavigationItem {
                label: "Histórico e\nDiagnósticos";
                icon-image: @image-url("../assets/icons/nav-history.svg");
                item-height: 58px;
                active: root.active-navigation == 6;
                selected => { root.navigation-selected(6); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #00000000;
        }

        Rectangle {
            height: 72px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.separator;
            background: Theme.dark-mode ? #071a31 : #ffffff;
            VerticalLayout {
                padding-left: 15px;
                padding-right: 10px;
                alignment: center;
                spacing: 3px;
                Text {

                    font-family: "Inter";
                    text: "Gamefic";
                    color: Theme.text-main;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {

                    font-family: "Inter";
                    text: "v0.1.0";
                    color: Theme.text-muted;
                    font-size: 13px;
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.separator;
    }
}

component AppCard inherits Rectangle {
    in property <string> app-name;
    in property <string> description;
    in property <image> app-icon;
    in property <bool> installed;
    in property <bool> highlighted;
    in property <string> category-name;
    in property <string> version;
    in property <string> developer;
    in property <string> source;
    in property <bool> has-update;
    callback activated(string, string, image, bool, string, string, string, string, bool);

    preferred-width: 323px;
    min-width: 260px;
    max-width: 323px;
    height: 212px;
    border-radius: 22px;
    border-width: root.highlighted || touch.has-hover ? 2px : 1px;
    border-color: root.highlighted || touch.has-hover ? Theme.accent : Theme.card-border;
    background: root.highlighted || touch.has-hover ? Theme.card-bg-highlight : Theme.card-bg;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 7px;
    drop-shadow-blur: root.highlighted || touch.has-hover ? 19px : 12px;
    drop-shadow-color: root.highlighted || touch.has-hover
        ? (Theme.dark-mode ? rgba(0, 190, 220, 0.22) : rgba(30, 130, 180, 0.20))
        : (Theme.dark-mode ? rgba(0, 8, 18, 0.30) : rgba(80, 130, 170, 0.13));

    VerticalLayout {
        padding: 22px;
        spacing: 12px;

        HorizontalLayout {
            height: 72px;
            spacing: 14px;
            alignment: start;

            Image {
                source: root.app-icon;
                width: 68px;
                height: 68px;
                image-fit: contain;
                vertical-alignment: center;
            }

            Text {


                font-family: "Inter";
                text: root.app-name;
                color: Theme.text-main;
                font-size: 22px;
                font-weight: 750;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        Text {


            font-family: "Inter";
            text: root.description;
            color: Theme.text-muted;
            font-size: 15px;
            font-weight: 450;
            height: 28px;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalLayout {
            height: 36px;
            alignment: end;

            Rectangle {
                width: root.installed ? 124px : 138px;
                height: 36px;
                border-radius: 18px;
                background: root.installed ? Theme.status-installed : Theme.status-not-installed;
                border-width: root.installed ? 0px : 1px;
                border-color: Theme.card-border;

                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 6px;
                    alignment: center;
                    Image {
                        source: root.installed
                            ? @image-url("../assets/icons/status-installed.svg")
                            : @image-url("../assets/icons/status-available.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: root.installed ? #ffffff : Theme.status-not-installed-text;
                        vertical-alignment: center;
                    }
                    Text {

                        font-family: "Inter";
                        text: root.installed ? "Instalado" : "Não instalado";
                        color: root.installed ? #ffffff : Theme.status-not-installed-text;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.activated(
                root.app-name,
                root.description,
                root.app-icon,
                root.installed,
                root.category-name,
                root.version,
                root.developer,
                root.source,
                root.has-update
            );
        }
    }
}

component AppCategory inherits VerticalLayout {
    in property <string> category-title;
    in property <[AppInfo]> apps;
    in property <string> selected-app;
    callback app-selected(string, string, image, bool, string, string, string, string, bool);

    spacing: 17px;

    Text {


        font-family: "Inter";
        text: root.category-title;
        color: Theme.text-main;
        font-size: 26px;
        font-weight: 750;
        height: 31px;
        vertical-alignment: center;
    }

    FlexboxLayout {
        width: 100%;
        flex-direction: row;
        flex-wrap: wrap;
        spacing-horizontal: 20px;
        spacing-vertical: 16px;
        cross-axis-alignment: stretch;

        for app in root.apps: AppCard {
            app-name: app.name;
            description: app.description;
            app-icon: app.icon;
            installed: app.installed;
            highlighted: app.name == root.selected-app;
            category-name: root.category-title;
            version: app.version;
            developer: app.developer;
            source: app.source;
            has-update: app.has_update;
            activated(name, description, icon, installed, category, version, developer, source, has-update) => {
                root.app-selected(name, description, icon, installed, category, version, developer, source, has-update);
            }
        }
    }
}

component DetailTile inherits Rectangle {
    in property <string> tile-label;
    in property <string> tile-value;

    horizontal-stretch: 1;
    height: 82px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.separator;
    background: Theme.dark-mode ? #071d35 : #f4f9fd;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 11px;
        padding-bottom: 11px;
        alignment: center;
        spacing: 5px;

        Text {
            font-family: "Inter";
            text: root.tile-label;
            color: Theme.text-muted;
            font-size: 12px;
            font-weight: 650;
        }

        Text {
            font-family: "Inter";
            text: root.tile-value;
            color: Theme.text-main;
            font-size: 14px;
            font-weight: 700;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component ModalAction inherits Rectangle {
    in property <string> label;
    in property <string> variant: "secondary";
    callback clicked();

    height: 44px;
    border-radius: 22px;
    border-width: root.variant == "secondary" ? 1px : 0px;
    border-color: Theme.card-border;
    background: root.variant == "primary"
        ? (touch.has-hover ? Theme.accent : Theme.accent-deep)
        : root.variant == "danger"
            ? (touch.has-hover ? #ce4b58 : #a93848)
            : (touch.has-hover ? Theme.card-bg-highlight : Theme.nav-hover);

    Text {
        font-family: "Inter";
        text: root.label;
        color: root.variant == "secondary" ? Theme.text-main : #ffffff;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Janela de detalhes do aplicativo, renderizada na MainWindow para ficar
// centralizada sobre a janela inteira (sidebar e barra superior incluídas).
component DetailsDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: rgba(2, 10, 24, 0.74);

    // Modal de tamanho fixo, centralizado sobre a janela inteira por cálculo
    // explícito (o VerticalLayout de centralização comportou-se de forma
    // instável quando o dialog é filho direto da Window).
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 760px;
        height: 620px;
        border-radius: 26px;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.card-bg;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 16px;
        drop-shadow-blur: 38px;
        drop-shadow-color: rgba(0, 0, 0, 0.46);

            VerticalLayout {
                padding: 30px;
                spacing: 15px;

                HorizontalLayout {
                    height: 86px;
                    spacing: 17px;

                    Image {
                        source: CatalogModal.icon;
                        width: 76px;
                        height: 76px;
                        image-fit: contain;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 5px;

                        Text {
                            font-family: "Inter";
                            text: CatalogModal.name;
                            color: Theme.text-main;
                            font-size: 26px;
                            font-weight: 750;
                            vertical-alignment: center;
                        }

                        Text {
                            font-family: "Inter";
                            text: CatalogModal.category;
                            color: Theme.text-muted;
                            font-size: 14px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 128px;
                        height: 34px;
                        border-radius: 17px;
                        background: CatalogModal.installed ? Theme.status-installed : Theme.status-not-installed;
                        border-width: CatalogModal.installed ? 0px : 1px;
                        border-color: Theme.card-border;

                        Text {
                            font-family: "Inter";
                            text: CatalogModal.installed ? "Instalado" : "Não instalado";
                            color: CatalogModal.installed ? #ffffff : Theme.status-not-installed-text;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 19px;
                        background: close-touch.has-hover ? Theme.card-bg-highlight : Theme.nav-hover;

                        Text {
                            font-family: "Inter";
                            text: "×";
                            color: Theme.text-main;
                            font-size: 25px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            clicked => { CatalogModal.open = false; }
                        }
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: Theme.separator;
                }

                VerticalLayout {
                    spacing: 7px;

                    Text {
                        font-family: "Inter";
                        text: "Sobre o aplicativo";
                        color: Theme.text-main;
                        font-size: 18px;
                        font-weight: 750;
                    }

                    Text {
                        font-family: "Inter";
                        text: CatalogModal.description;
                        color: Theme.text-muted;
                        font-size: 15px;
                        wrap: word-wrap;
                        height: 48px;
                        vertical-alignment: top;
                    }
                }

                HorizontalLayout {
                    height: 82px;
                    spacing: 12px;

                    DetailTile {
                        tile-label: "Versão instalada";
                        tile-value: CatalogModal.version;
                    }

                    DetailTile {
                        tile-label: "Desenvolvedor";
                        tile-value: CatalogModal.developer;
                    }

                    DetailTile {
                        tile-label: "Origem";
                        tile-value: CatalogModal.source;
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: Theme.separator;
                }

                VerticalLayout {
                    spacing: 8px;

                    Text {
                        font-family: "Inter";
                        text: "Ações";
                        color: Theme.text-main;
                        font-size: 17px;
                        font-weight: 750;
                    }

                    HorizontalLayout {
                        height: 44px;
                        spacing: 10px;

                        if CatalogModal.installed: ModalAction {
                            width: 132px;
                            label: "Abrir";
                            variant: "primary";
                            clicked => {
                                CatalogModal.action-message = "Abrir: integração com o backend ainda pendente.";
                            }
                        }

                        if CatalogModal.installed && CatalogModal.has-update: ModalAction {
                            width: 138px;
                            label: "Atualizar";
                            variant: "secondary";
                            clicked => {
                                CatalogModal.action-message = "Atualizar: a verificação de versões ainda não está conectada.";
                            }
                        }

                        if CatalogModal.installed: ModalAction {
                            width: 132px;
                            label: "Remover";
                            variant: "danger";
                            clicked => {
                                CatalogModal.action-message = "Remover: nenhum comando foi executado; falta integrar o gerenciador de pacotes.";
                            }
                        }

                        if !CatalogModal.installed: ModalAction {
                            width: 160px;
                            label: "Escolher fonte";
                            variant: "secondary";
                            clicked => {
                                CatalogModal.action-message = "As fontes disponíveis serão listadas quando a detecção do sistema for integrada.";
                            }
                        }

                        if !CatalogModal.installed: ModalAction {
                            width: 132px;
                            label: "Instalar";
                            variant: "primary";
                            clicked => {
                                CatalogModal.action-message = "Instalar: nenhum comando foi executado; falta integrar o gerenciador de pacotes.";
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: #00000000;
                        }

                        ModalAction {
                            width: 118px;
                            label: "Fechar";
                            variant: "secondary";
                            clicked => { CatalogModal.open = false; }
                        }
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 42px;
                    border-radius: 12px;
                    background: Theme.dark-mode ? #071a30 : #f0f7fc;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            font-family: "Inter";
                            text: "i";
                            color: Theme.accent;
                            font-size: 15px;
                            font-weight: 800;
                        }

                        Text {
                            font-family: "Inter";
                            text: CatalogModal.action-message;
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
    }
}

component AppCatalogPage inherits Rectangle {
