component AppCard inherits Rectangle {
    in property <AppInfo> app;
    in property <bool> highlighted;
    callback activated(AppInfo);

    preferred-width: 323px;
    min-width: 260px;
    max-width: 323px;
    height: 212px;
    border-radius: 22px;
    border-width: root.highlighted || touch.has-hover ? 2px : 1px;
    border-color: root.highlighted || touch.has-hover ? Theme.accent : Theme.card-border;
    background: root.highlighted || touch.has-hover ? Theme.card-bg-highlight : Theme.card-bg;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 7px;
    drop-shadow-blur: root.highlighted || touch.has-hover ? 19px : 12px;
    drop-shadow-color: root.highlighted || touch.has-hover
        ? (Theme.dark-mode ? rgba(0, 190, 220, 0.22) : rgba(30, 130, 180, 0.20))
        : (Theme.dark-mode ? rgba(0, 8, 18, 0.30) : rgba(80, 130, 170, 0.13));

    VerticalLayout {
        padding: 22px;
        spacing: 12px;

        HorizontalLayout {
            height: 72px;
            spacing: 14px;
            alignment: start;

            AppIcon {
                app-id: root.app.id;
            }

            Text {

                font-family: "Inter";
                text: root.app.name;
                color: Theme.text-main;
                font-size: 22px;
                font-weight: 750;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        Text {

            font-family: "Inter";
            text: root.app.description;
            color: Theme.text-muted;
            font-size: 15px;
            font-weight: 450;
            height: 28px;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalLayout {
            height: 36px;
            alignment: end;

            Rectangle {
                width: root.app.estado == "instalado" ? 124px : 138px;
                height: 36px;
                border-radius: 18px;
                background: root.app.estado == "instalado"
                    ? Theme.status-installed
                    : root.app.estado == "nao_instalado" ? Theme.status-not-installed : Theme.nav-hover;
                border-width: root.app.estado == "instalado" ? 0px : 1px;
                border-color: Theme.card-border;

                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 6px;
                    alignment: center;

                    if root.app.estado != "desconhecido": Image {
                        source: root.app.estado == "instalado"
                            ? @image-url("../assets/icons/status-installed.svg")
                            : @image-url("../assets/icons/status-available.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: root.app.estado == "instalado" ? #ffffff : Theme.status-not-installed-text;
                        vertical-alignment: center;
                    }
                    Text {

                        font-family: "Inter";
                        text: root.app.estado == "instalado"
                            ? "Instalado"
                            : root.app.estado == "nao_instalado" ? "Não instalado" : "Desconhecido";
                        color: root.app.estado == "instalado"
                            ? #ffffff
                            : root.app.estado == "desconhecido" ? Theme.text-muted : Theme.status-not-installed-text;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.activated(root.app);
        }
    }
}

component AppCategory inherits VerticalLayout {
    in property <string> category-title;
    in property <[AppInfo]> apps;
    in property <string> selected-app;
    callback app-selected(AppInfo);

    spacing: 17px;

    Text {

        font-family: "Inter";
        text: root.category-title;
        color: Theme.text-main;
        font-size: 26px;
        font-weight: 750;
        height: 31px;
        vertical-alignment: center;
    }

    FlexboxLayout {
        width: 100%;
        flex-direction: row;
        flex-wrap: wrap;
        spacing-horizontal: 20px;
        spacing-vertical: 16px;
        cross-axis-alignment: stretch;

        for app in root.apps: AppCard {
            app: app;
            highlighted: app.name == root.selected-app;
            activated(e) => {
                CatalogModal.open-from-app(e, root.category-title);
                root.app-selected(e);
            }
        }

        // Estado de carregamento/vazio honesto: enquanto a detecção não
        // terminou, nada é mostrado como instalado ou instalável.
        if root.apps.length == 0: Rectangle {
            height: 120px;
            background: transparent;

            Text {
                font-family: "Inter";
                text: CatalogData.loaded ? "Nenhum aplicativo nesta categoria." : "Consultando o catálogo do sistema…";
                color: Theme.text-muted;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component DetailTile inherits Rectangle {
    in property <string> tile-label;
    in property <string> tile-value;

    horizontal-stretch: 1;
    height: 82px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.separator;
    background: Theme.dark-mode ? #071d35 : #f4f9fd;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 11px;
        padding-bottom: 11px;
        alignment: center;
        spacing: 5px;

        Text {
            font-family: "Inter";
            text: root.tile-label;
            color: Theme.text-muted;
            font-size: 12px;
            font-weight: 650;
        }

        Text {
            font-family: "Inter";
            text: root.tile-value;
            color: Theme.text-main;
            font-size: 14px;
            font-weight: 700;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component ModalAction inherits Rectangle {
    in property <string> label;
    in property <string> variant: "secondary";
    callback clicked();

    height: 44px;
    border-radius: 22px;
    border-width: root.variant == "secondary" ? 1px : 0px;
    border-color: Theme.card-border;
    background: root.variant == "primary"
        ? (touch.has-hover ? Theme.accent : Theme.accent-deep)
        : root.variant == "danger"
            ? (touch.has-hover ? #ce4b58 : #a93848)
            : (touch.has-hover ? Theme.card-bg-highlight : Theme.nav-hover);

    Text {
        font-family: "Inter";
        text: root.label;
        color: root.variant == "secondary" ? Theme.text-main : #ffffff;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Janela de detalhes do aplicativo, renderizada na MainWindow para ficar
// centralizada sobre a janela inteira (sidebar e barra superior incluídas).
component DetailsDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: rgba(2, 10, 24, 0.74);

    // Zona de fechamento cobrindo a janela toda: um clique fora do cartão
    // fecha o modal (mesma ação do botão Fechar) e absorve o toque para que
    // nada atrás dele fique clicável. Os controles do cartão ficam acima e
    // continuam funcionando normalmente.
    tap-fora := TouchArea {
        clicked => { CatalogModal.open = false; }
    }

    // Modal de tamanho fixo, centralizado sobre a janela inteira por cálculo
    // explícito (o VerticalLayout de centralização comportou-se de forma
    // instável quando o dialog é filho direto da Window).
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 760px;
        height: 620px;
        border-radius: 26px;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.card-bg;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 16px;
        drop-shadow-blur: 38px;
        drop-shadow-color: rgba(0, 0, 0, 0.46);

        // absorve os toques nos espaços do cartão sem controles (textos,
        // separadores): sem isso, o clique atravessa para a zona de fora
        // e o modal fecha ao tocar dentro dele
        TouchArea { }

            VerticalLayout {
                padding: 30px;
                spacing: 15px;

                HorizontalLayout {
                    height: 86px;
                    spacing: 17px;

                    AppIcon {
                        app-id: CatalogModal.app-id;
                        width: 76px;
                        height: 76px;
                    }

                    VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 5px;

                        Text {
                            font-family: "Inter";
                            text: CatalogModal.name;
                            color: Theme.text-main;
                            font-size: 26px;
                            font-weight: 750;
                            vertical-alignment: center;
                        }

                        Text {
                            font-family: "Inter";
                            text: CatalogModal.category;
                            color: Theme.text-muted;
                            font-size: 14px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 128px;
                        height: 34px;
                        border-radius: 17px;
                        background: CatalogModal.estado == "instalado"
                            ? Theme.status-installed
                            : CatalogModal.estado == "nao_instalado" ? Theme.status-not-installed : Theme.nav-hover;
                        border-width: CatalogModal.estado == "instalado" ? 0px : 1px;
                        border-color: Theme.card-border;

                        Text {
                            font-family: "Inter";
                            text: CatalogModal.estado == "instalado"
                                ? "Instalado"
                                : CatalogModal.estado == "nao_instalado" ? "Não instalado" : "Desconhecido";
                            color: CatalogModal.estado == "instalado"
                                ? #ffffff
                                : CatalogModal.estado == "desconhecido" ? Theme.text-muted : Theme.status-not-installed-text;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // O "×" de fechar foi removido: o encerramento acontece
                    // pelo botão Fechar (canto inferior direito), pelo clique
                    // fora do cartão ou como qualquer ação de fechamento nativa.
                }

                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: Theme.separator;
                }

                VerticalLayout {
                    spacing: 7px;

                    Text {
                        font-family: "Inter";
                        text: "Sobre o aplicativo";
                        color: Theme.text-main;
                        font-size: 18px;
                        font-weight: 750;
                    }

                    Text {
                        font-family: "Inter";
                        text: CatalogModal.description;
                        color: Theme.text-muted;
                        font-size: 15px;
                        wrap: word-wrap;
                        height: 48px;
                        vertical-alignment: top;
                    }
                }

                HorizontalLayout {
                    height: 82px;
                    spacing: 12px;

                    DetailTile {
                        tile-label: "Versão instalada";
                        tile-value: CatalogModal.version;
                    }

                    DetailTile {
                        tile-label: "Desenvolvedor";
                        tile-value: CatalogModal.developer;
                    }

                    DetailTile {
                        tile-label: "Origem";
                        tile-value: CatalogModal.source;
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: Theme.separator;
                }

                VerticalLayout {
                    spacing: 8px;

                    Text {
                        font-family: "Inter";
                        text: "Ações";
                        color: Theme.text-main;
                        font-size: 17px;
                        font-weight: 750;
                    }

                    HorizontalLayout {
                        height: 44px;
                        spacing: 10px;

                        if CatalogModal.estado == "instalado": ModalAction {
                            width: 132px;
                            label: "Abrir";
                            variant: "primary";
                            clicked => {
                                CatalogData.abrir-app(CatalogModal.app-id);
                            }
                        }

                        if CatalogModal.estado == "instalado" && CatalogModal.has-update: ModalAction {
                            width: 138px;
                            label: "Atualizar";
                            variant: "secondary";
                            clicked => {
                                CatalogData.acao-app(CatalogModal.app-id, "atualizar");
                            }
                        }

                        if CatalogModal.estado == "instalado": ModalAction {
                            width: 132px;
                            label: "Remover";
                            variant: "danger";
                            clicked => {
                                CatalogData.acao-app(CatalogModal.app-id, "remover");
                            }
                        }

                        if CatalogModal.estado == "nao_instalado": ModalAction {
                            width: 160px;
                            label: "Escolher fonte";
                            variant: "secondary";
                            clicked => {
                                CatalogData.fontes-app(CatalogModal.app-id);
                            }
                        }

                        if CatalogModal.estado == "nao_instalado": ModalAction {
                            width: 132px;
                            label: "Instalar";
                            variant: "primary";
                            clicked => {
                                CatalogData.acao-app(CatalogModal.app-id, "instalar");
                            }
                        }

                        // Sem confirmação de instalação (desconhecido), nenhuma
                        // ação é ofertada — sem comando nem promessa de estado.

                        Rectangle {
                            horizontal-stretch: 1;
                            background: #00000000;
                        }

                        ModalAction {
                            width: 118px;
                            label: "Fechar";
                            variant: "secondary";
                            clicked => { CatalogModal.open = false; }
                        }
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 42px;
                    border-radius: 12px;
                    background: Theme.dark-mode ? #071a30 : #f0f7fc;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            font-family: "Inter";
                            text: "i";
                            color: Theme.accent;
                            font-size: 15px;
                            font-weight: 800;
                        }

                        Text {
                            font-family: "Inter";
                            text: CatalogData.acao-mensagem;
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
    }
}

component AppCatalogPage inherits Rectangle {
    in-out property <string> selected-app: "";
    callback app-selected(AppInfo);

    background: Theme.page-bg;

    ScrollView {
        width: 100%;
        height: 100%;
        // sem content-height fixo: o Flickable deriva do preferred-height do
        // conteúdo real (o FlexboxLayout com wrap mede todas as linhas com a
        // largura disponível) — mudanças de catálogo/tamanho não cortam cards
        vertical-scrollbar-policy: as-needed;
        horizontal-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            width: 100%;
            padding-left: 40px;
            padding-right: 56px;
            padding-top: 36px;
            padding-bottom: 38px;
            spacing: 28px;

            VerticalLayout {
                spacing: 8px;
                height: 78px;
                Text {

                    font-family: "Inter";
                    text: "Apps";
                    color: Theme.text-main;
                    font-size: 36px;
                    font-weight: 800;
                    height: 43px;
                }
                Text {

                    font-family: "Inter";
                    text: "Gerencie e instale aplicativos essenciais para jogos no Linux, incluindo launchers, emuladores e ferramentas para aprimorar sua experiência gamer.";
                    color: Theme.text-muted;
                    font-size: 16px;
                    height: 25px;
                    vertical-alignment: center;
                }
                Text {

                    font-family: "Inter";
                    text: CatalogData.loaded ? CatalogData.status : "Consultando o catálogo do sistema…";
                    color: Theme.text-muted;
                    font-size: 13px;
                }
            }

            AppCategory {
                category-title: "Launchers";
                selected-app: root.selected-app;
                apps: CatalogData.launchers;
                app-selected(app) => { root.app-selected(app); }
            }

            AppCategory {
                category-title: "Emuladores";
                selected-app: root.selected-app;
                apps: CatalogData.emuladores;
                app-selected(app) => { root.app-selected(app); }
            }

            AppCategory {
                category-title: "Ferramentas de jogos";
                selected-app: root.selected-app;
                apps: CatalogData.tools;
                app-selected(app) => { root.app-selected(app); }
            }

            AppCategory {
                category-title: "Compatibilidade";
                selected-app: root.selected-app;
                apps: CatalogData.compatibilidade;
                app-selected(app) => { root.app-selected(app); }
            }
        }
    }
}

// Aba Criação de Conteúdo: catálogo de ferramentas de gravação, edição,
// áudio e comunicação — reutiliza AppCategory/AppCard e o modal global.
component ContentPage inherits Rectangle {
    in-out property <string> selected-app: "";
    callback app-selected(AppInfo);

    background: Theme.page-bg;

    ScrollView {
        width: 100%;
        height: 100%;
        // mesmo ajuste da aba Apps: alturas derivadas do conteúdo real
        vertical-scrollbar-policy: as-needed;
        horizontal-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            width: 100%;
            padding-left: 40px;
            padding-right: 56px;
            padding-top: 36px;
            padding-bottom: 38px;
            spacing: 28px;

            VerticalLayout {
                spacing: 8px;
                height: 78px;
                Text {

                    font-family: "Inter";
                    text: "Criação de Conteúdo";
                    color: Theme.text-main;
                    font-size: 36px;
                    font-weight: 800;
                    height: 43px;
                }
                Text {

                    font-family: "Inter";
                    text: "Ferramentas para gravação de gameplay, transmissão ao vivo, edição de vídeos, captura de tela e produção de áudio.";
                    color: Theme.text-muted;
                    font-size: 16px;
                    height: 25px;
                    vertical-alignment: center;
                }
                Text {

                    font-family: "Inter";
                    text: CatalogData.loaded ? CatalogData.status : "Consultando o catálogo do sistema…";
                    color: Theme.text-muted;
                    font-size: 13px;
                }
            }

            AppCategory {
                category-title: "Gravação e Stream";
                selected-app: root.selected-app;
                apps: CatalogData.criacao-gravacao;
                app-selected(app) => { root.app-selected(app); }
            }

            AppCategory {
                category-title: "Vídeo";
                selected-app: root.selected-app;
                apps: CatalogData.criacao-video;
                app-selected(app) => { root.app-selected(app); }
            }

            AppCategory {
                category-title: "Áudio";
                selected-app: root.selected-app;
                apps: CatalogData.criacao-audio;
                app-selected(app) => { root.app-selected(app); }
            }

            AppCategory {
                category-title: "Social";
                selected-app: root.selected-app;
                apps: CatalogData.criacao-social;
                app-selected(app) => { root.app-selected(app); }
            }
        }
    }
}

component PlaceholderPage inherits Rectangle {
    in property <string> page-title;
    background: Theme.page-bg;

    VerticalLayout {
        padding: 42px;
        spacing: 12px;
        Text {

            font-family: "Inter";
            text: root.page-title;
            color: Theme.text-main;
            font-size: 36px;
            font-weight: 800;
        }
        Text {

            font-family: "Inter";
            text: "Esta seção faz parte da estrutura visual do Gamefic. Os recursos e integrações serão implementados em etapas próprias.";
            color: Theme.text-muted;
            font-size: 16px;
            wrap: word-wrap;
            max-width: 760px;
        }
    }
}

// ---- Monitor (adaptado da PerformancePage do repo Gamefic, branch gamefic-slint) ----
// Estados vazios/indisponíveis seguem o padrão do catálogo: nenhum dado é
// estimado; valores reais chegam quando o backend do monitor for integrado.

component IntervalOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();

    width: 54px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.card-border;
    background: root.selected
        ? (Theme.dark-mode ? rgba(22, 211, 232, 0.16) : rgba(7, 153, 223, 0.12))
        : Theme.nav-hover;

    Text {
        font-family: "Inter";
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text-muted;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    option-touch := TouchArea { clicked => { root.activated(); } }
}

component MetricChart inherits Rectangle {
    in property <string> path-data;
    in property <color> line-color: Theme.accent;
    height: 64px;
    background: transparent;

    Rectangle {
        y: 16px;
        width: 100%;
        height: 1px;
        background: Theme.separator;
    }
    Rectangle {
        y: 40px;
        width: 100%;
        height: 1px;
        background: Theme.separator;
    }
    Path {
        commands: root.path-data;
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.line-color;
        stroke-width: 2.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

component MetricCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> detail-a;
    in property <string> detail-b;
    in property <string> history-path;
    in property <color> line-color: Theme.accent;

    height: 224px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-bg;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 7px;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.dark-mode ? rgba(0, 8, 18, 0.30) : rgba(80, 130, 170, 0.13);

    VerticalLayout {
        padding: 15px;
        spacing: 9px;

        HorizontalLayout {
            Text {
                font-family: "Inter";
                text: root.title;
                color: Theme.text-muted;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle {
                width: 7px;
                Rectangle {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: root.line-color;
                }
            }
        }

        Text {
            font-family: "Inter";
            text: root.value;
            color: Theme.text-main;
            font-size: 27px;
            font-weight: 750;
            vertical-alignment: center;
        }

        Text {
            font-family: "Inter";
            text: root.detail-a;
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
            max-lines: 2;
        }
        Text {
            font-family: "Inter";
            text: root.detail-b;
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
            max-lines: 2;
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
        MetricChart {
            path-data: root.history-path;
            line-color: root.line-color;
        }
    }
}

component MemoryColumn inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> detail-a;
    in property <string> detail-b;
    in property <string> history-path;
    in property <color> line-color: Theme.accent;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            font-family: "Inter";
            text: root.title;
            color: Theme.text-muted;
            font-size: 12px;
            font-weight: 700;
        }
        Text {
            font-family: "Inter";
            text: root.value;
            color: Theme.text-main;
            font-size: 25px;
            font-weight: 750;
        }
        Text {
            font-family: "Inter";
            text: root.detail-a;
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
        }
        Text {
            font-family: "Inter";
            text: root.detail-b;
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
        MetricChart {
            path-data: root.history-path;
            line-color: root.line-color;
        }
    }
}

// Aba Monitor: métricas em tempo real (CPU, rede, GPU, VRAM, RAM, SWAP) e
// armazenamento, conforme a PerformancePage do repo Gamefic. Enquanto o
// backend não é integrado, os cartões mostram os estados vazios do repo
// ("—", "Não disponível") e os gráficos ficam sem amostras.
component MonitorPage inherits Rectangle {
    in-out property <int> interval-ms: 2000;

    background: Theme.page-bg;

    VerticalLayout {
        padding-left: 40px;
        padding-right: 56px;
        padding-top: 36px;
        padding-bottom: 38px;
        spacing: 18px;

        HorizontalLayout {
            height: 64px;
            spacing: 12px;

            VerticalLayout {
                spacing: 4px;
                Text {
                    font-family: "Inter";
                    text: "Monitor do Sistema";
                    color: Theme.text-main;
                    font-size: 36px;
                    font-weight: 800;
                    height: 43px;
                }
                Text {
                    font-family: "Inter";
                    text: "Métricas em tempo real do hardware e da rede";
                    color: Theme.text-muted;
                    font-size: 16px;
                    vertical-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                font-family: "Inter";
                text: "INTERVALO";
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
            IntervalOption {
                label: "1 s";
                selected: root.interval-ms == 1000;
                activated => { root.interval-ms = 1000; }
            }
            IntervalOption {
                label: "2 s";
                selected: root.interval-ms == 2000;
                activated => { root.interval-ms = 2000; }
            }
            IntervalOption {
                label: "5 s";
                selected: root.interval-ms == 5000;
                activated => { root.interval-ms = 5000; }
            }
        }

        HorizontalLayout {
            height: 224px;
            spacing: 12px;
            MetricCard {
                horizontal-stretch: 1;
                title: "CPU";
                value: "—";
                detail-a: "Aguardando primeira amostra";
                detail-b: "Frequência média indisponível";
                history-path: "";
                line-color: #a78bfa;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "REDE";
                value: "Aguardando dados";
                detail-a: "Download: —";
                detail-b: "Upload: —";
                history-path: "";
                line-color: #22d3ee;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "GPU";
                value: "Não disponível";
                detail-a: "Métricas dependem do driver";
                detail-b: "Temperatura: —";
                history-path: "";
                line-color: #22d3ee;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "VRAM";
                value: "Não disponível";
                detail-a: "Memória de vídeo indisponível";
                detail-b: "Uso: —";
                history-path: "";
                line-color: #a78bfa;
            }
        }

        HorizontalLayout {
            height: 268px;
            spacing: 12px;

            Rectangle {
                horizontal-stretch: 3;
                height: 268px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.card-border;
                background: Theme.card-bg;
                drop-shadow-offset-x: 0px;
                drop-shadow-offset-y: 7px;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.dark-mode ? rgba(0, 8, 18, 0.30) : rgba(80, 130, 170, 0.13);

                HorizontalLayout {
                    MemoryColumn {
                        horizontal-stretch: 1;
                        title: "MEMÓRIA RAM";
                        value: "—";
                        detail-a: "Em uso: —";
                        detail-b: "Disponível: —";
                        history-path: "";
                        line-color: #a78bfa;
                    }
                    Rectangle {
                        width: 1px;
                        Rectangle {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: 1px;
                            height: 210px;
                            background: Theme.separator;
                        }
                    }
                    MemoryColumn {
                        horizontal-stretch: 1;
                        title: "SWAP";
                        value: "—";
                        detail-a: "Em uso: —";
                        detail-b: "Disponível: —";
                        history-path: "";
                        line-color: #22d3ee;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 2;
                height: 268px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.card-border;
                background: Theme.card-bg;
                drop-shadow-offset-x: 0px;
                drop-shadow-offset-y: 7px;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.dark-mode ? rgba(0, 8, 18, 0.30) : rgba(80, 130, 170, 0.13);

                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        font-family: "Inter";
                        text: "ARMAZENAMENTO";
                        color: Theme.text-muted;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text {
                        font-family: "Inter";
                        text: "Leitura de unidades ainda não integrada ao Gamefic.";
                        color: Theme.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    Text {
                        font-family: "Inter";
                        text: "Nenhuma capacidade ou utilização é estimada.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Text {
            font-family: "Inter";
            text: "Dados indisponíveis são exibidos sem estimativas. A telemetria da GPU depende do suporte do driver.";
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

export component MainWindow inherits Window {
    title: "Gamefic";
    no-frame: true;
    resize-border-width: 5px;
    // preferred (não width/height): o tamanho de partida não fica preso a
    // uma restrição fixa construtiva — a janela abre nessa medida, cabe
    // melhor na tela do usuário e pode ser redimensionada livremente
    preferred-width: 1920px;
    preferred-height: 1040px;
    // abaixo disto, o modal fixo (760px) e a sidebar (256px) não convivem
    min-width: 1024px;
    min-height: 648px;
    background: transparent;

    in-out property <int> active-navigation: 0;
    in-out property <string> selected-app: "";
    property <string> page-title: root.active-navigation == 3 ? "Kernels e Drivers"
        : root.active-navigation == 4 ? "Otimização"
        : root.active-navigation == 5 ? "Overlay"
        : "Histórico e Diagnósticos";

    // Contêiner com cantos arredondados: com a janela sem moldura e fundo
    // transparente, todo o conteúdo fica dentro deste retângulo com clip,
    // conferindo cantos arredondados à janela e à barra lateral.
    shape := Rectangle {
        border-radius: 18px;
        clip: true;

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            TitleBar {
                minimize-requested => { root.minimized = true; }
                maximize-requested => { root.maximized = !root.maximized; }
                close-requested => { root.close(); }
            }

            HorizontalLayout {
                height: 100%;
                spacing: 0px;

                Sidebar {
                    width: 256px;
                    active-navigation: root.active-navigation;
                    navigation-selected(index) => { root.active-navigation = index; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.page-bg;
                }
            }
        }

        if root.active-navigation == 0: AppCatalogPage {
            x: 256px;
            y: 42px;
            width: parent.width - 256px;
            height: parent.height - 42px;
            selected-app: root.selected-app;
            app-selected(app) => { root.selected-app = app.name; }
        }

        if root.active-navigation == 1: ContentPage {
            x: 256px;
            y: 42px;
            width: parent.width - 256px;
            height: parent.height - 42px;
            selected-app: root.selected-app;
            app-selected(app) => { root.selected-app = app.name; }
        }

        if root.active-navigation == 2: MonitorPage {
            x: 256px;
            y: 42px;
            width: parent.width - 256px;
            height: parent.height - 42px;
        }

        if root.active-navigation >= 3: PlaceholderPage {
            x: 256px;
            y: 42px;
            width: parent.width - 256px;
            height: parent.height - 42px;
            page-title: root.page-title;
        }

        if CatalogModal.open: DetailsDialog {
            width: parent.width;
            height: parent.height;
        }
    }
}
