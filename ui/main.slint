import { ScrollView } from "std-widgets.slint";

global Theme {
    in-out property <bool> dark-mode: true;

    out property <color> window-bg: dark-mode ? #061a32 : #ffffff;
    out property <brush> sidebar-bg: dark-mode
        ? @linear-gradient(180deg, #061a32 0%, #041329 100%)
        : @linear-gradient(180deg, #ffffff 0%, #f7fafe 100%);
    out property <color> topbar-bg: dark-mode ? #061a32 : #ffffff;
    out property <brush> page-bg: dark-mode
        ? @linear-gradient(18deg, #092d50 0%, #071d37 52%, #04162b 100%)
        : @linear-gradient(145deg, #ffffff 0%, #fbfdff 58%, #f3f9fe 100%);
    out property <brush> card-bg: dark-mode
        ? @linear-gradient(145deg, #0c2b49 0%, #08223e 58%, #071d36 100%)
        : @linear-gradient(145deg, #f3faff 0%, #e7f3fc 58%, #e2f0fb 100%);
    out property <brush> card-bg-highlight: dark-mode
        ? @linear-gradient(145deg, #124064 0%, #0b3153 58%, #082642 100%)
        : @linear-gradient(145deg, #e3f5ff 0%, #d7edfb 58%, #cce8f9 100%);
    out property <color> nav-hover: dark-mode ? #102e49 : #edf6fc;
    out property <color> card-border: dark-mode ? #1a3e5e : #d5e8f5;
    out property <color> separator: dark-mode ? #193552 : #e7eef4;
    out property <color> text-main: dark-mode ? #f4f8ff : #09295d;
    out property <color> text-muted: dark-mode ? #a8c6da : #35658c;
    out property <color> accent: dark-mode ? #16d3e8 : #0799df;
    out property <color> accent-deep: dark-mode ? #087fc7 : #087fd3;
    out property <color> active-menu: dark-mode ? #0796d4 : #1689e4;
    out property <color> status-installed: dark-mode ? #079fd0 : #168ee6;
    out property <color> status-not-installed: dark-mode ? #123b50 : #f8fcff;
    out property <color> status-not-installed-text: dark-mode ? #d5edf6 : #23638d;
}

struct AppInfo {
    name: string,
    description: string,
    icon: image,
    installed: bool,
    version: string,
    developer: string,
    source: string,
    has_update: bool,
}

component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <image> icon-image;
    in property <bool> active;
    in property <length> item-height: 52px;
    callback selected();

    height: item-height;
    border-radius: 14px;
    background: root.active ? Theme.active-menu : touch.has-hover ? Theme.nav-hover : #00000000;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        alignment: start;
        Image {
            source: root.icon-image;
            width: 22px;
            height: 22px;
            image-fit: contain;
            colorize: root.active ? #ffffff : Theme.text-main;
            vertical-alignment: center;
        }
        Text {

            font-family: "Inter";
            text: root.label;
            color: root.active ? #ffffff : Theme.text-main;
            font-size: 18px;
            font-weight: root.active ? 700 : 550;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        clicked => { root.selected(); }
    }
}

component Sidebar inherits Rectangle {
    in property <int> active-navigation: 0;
    callback navigation-selected(int);

    background: Theme.sidebar-bg;

    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 25px;
        padding-bottom: 17px;
        spacing: 22px;

        VerticalLayout {
            spacing: 8px;
            alignment: center;
            Image {
                source: @image-url("../assets/icons/gamefic.svg");
                width: 80px;
                height: 80px;
                image-fit: contain;
            }
            Text {

                font-family: "Inter";
                text: "Gamefic";
                color: Theme.text-main;
                font-size: 24px;
                font-weight: 750;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 8px;

            NavigationItem {
                label: "Apps";
                icon-image: @image-url("../assets/icons/nav-apps.svg");
                active: root.active-navigation == 0;
                selected => { root.navigation-selected(0); }
            }
            NavigationItem {
                label: "Criação de\nConteúdo";
                icon-image: @image-url("../assets/icons/nav-content.svg");
                item-height: 58px;
                active: root.active-navigation == 1;
                selected => { root.navigation-selected(1); }
            }
            NavigationItem {
                label: "Monitorado";
                icon-image: @image-url("../assets/icons/nav-monitor.svg");
                active: root.active-navigation == 2;
                selected => { root.navigation-selected(2); }
            }
            NavigationItem {
                label: "Kernels e Drivers";
                icon-image: @image-url("../assets/icons/nav-drivers.svg");
                active: root.active-navigation == 3;
                selected => { root.navigation-selected(3); }
            }
            NavigationItem {
                label: "Otimização";
                icon-image: @image-url("../assets/icons/nav-optimization.svg");
                active: root.active-navigation == 4;
                selected => { root.navigation-selected(4); }
            }
            NavigationItem {
                label: "Overlay";
                icon-image: @image-url("../assets/icons/nav-overlay.svg");
                active: root.active-navigation == 5;
                selected => { root.navigation-selected(5); }
            }
            NavigationItem {
                label: "Histórico e\nDiagnósticos";
                icon-image: @image-url("../assets/icons/nav-history.svg");
                item-height: 58px;
                active: root.active-navigation == 6;
                selected => { root.navigation-selected(6); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #00000000;
        }

        Rectangle {
            height: 72px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.separator;
            background: Theme.dark-mode ? #071a31 : #ffffff;
            VerticalLayout {
                padding-left: 15px;
                padding-right: 10px;
                alignment: center;
                spacing: 3px;
                Text {

                    font-family: "Inter";
                    text: "Gamefic";
                    color: Theme.text-main;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {

                    font-family: "Inter";
                    text: "v0.1.0";
                    color: Theme.text-muted;
                    font-size: 13px;
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.separator;
    }
}

component TopBar inherits Rectangle {
    callback theme-toggle();
    callback sources-clicked();
    callback updates-clicked();

    background: Theme.topbar-bg;

    HorizontalLayout {
        padding-left: 40px;
        padding-right: 30px;
        spacing: 14px;
        alignment: center;

        Text {


            font-family: "Inter";
            text: "Gamefic";
            color: Theme.text-main;
            font-size: 24px;
            font-weight: 750;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #00000000;
        }

        Rectangle {
            width: 174px;
            height: 40px;
            border-radius: 20px;
            background: sources-touch.has-hover ? Theme.accent : Theme.accent-deep;
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 15px;
                spacing: 8px;
                alignment: center;
                Image {
                    source: @image-url("../assets/icons/chevron-down.svg");
                    width: 14px;
                    height: 14px;
                    image-fit: contain;
                }
                Text {

                    font-family: "Inter";
                    text: "Fontes disponíveis";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 650;
                    vertical-alignment: center;
                }
            }
            sources-touch := TouchArea {
                clicked => { root.sources-clicked(); }
            }
        }

        Rectangle {
            width: 150px;
            height: 40px;
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.separator;
            background: updates-touch.has-hover ? Theme.nav-hover : (Theme.dark-mode ? #07192e : #ffffff);
            HorizontalLayout {
                padding-left: 15px;
                padding-right: 13px;
                spacing: 9px;
                alignment: center;
                Text {

                    font-family: "Inter";
                    text: "Atualizações";
                    color: Theme.text-main;
                    font-size: 14px;
                    font-weight: 600;
                }
                Image {
                    source: @image-url("../assets/icons/chevron-down.svg");
                    width: 13px;
                    height: 13px;
                    image-fit: contain;
                    colorize: Theme.text-muted;
                }
            }
            updates-touch := TouchArea {
                clicked => { root.updates-clicked(); }
            }
        }

        Rectangle {
            width: 42px;
            height: 42px;
            border-radius: 21px;
            background: settings-touch.has-hover ? Theme.nav-hover : #00000000;
            Image {
                source: @image-url("../assets/icons/settings.svg");
                width: 25px;
                height: 25px;
                image-fit: contain;
                colorize: Theme.text-main;
            }
            settings-touch := TouchArea {
                clicked => { root.theme-toggle(); }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.separator;
    }
}

component AppCard inherits Rectangle {
    in property <string> app-name;
    in property <string> description;
    in property <image> app-icon;
    in property <bool> installed;
    in property <bool> highlighted;
    in property <string> category-name;
    in property <string> version;
    in property <string> developer;
    in property <string> source;
    in property <bool> has-update;
    callback activated(string, string, image, bool, string, string, string, string, bool);

    preferred-width: 323px;
    min-width: 260px;
    max-width: 323px;
    height: 212px;
    border-radius: 22px;
    border-width: root.highlighted || touch.has-hover ? 2px : 1px;
    border-color: root.highlighted || touch.has-hover ? Theme.accent : Theme.card-border;
    background: root.highlighted || touch.has-hover ? Theme.card-bg-highlight : Theme.card-bg;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 7px;
    drop-shadow-blur: root.highlighted || touch.has-hover ? 19px : 12px;
    drop-shadow-color: root.highlighted || touch.has-hover
        ? (Theme.dark-mode ? rgba(0, 190, 220, 0.22) : rgba(30, 130, 180, 0.20))
        : (Theme.dark-mode ? rgba(0, 8, 18, 0.30) : rgba(80, 130, 170, 0.13));

    VerticalLayout {
        padding: 22px;
        spacing: 12px;

        HorizontalLayout {
            height: 72px;
            spacing: 14px;
            alignment: start;

            Image {
                source: root.app-icon;
                width: 68px;
                height: 68px;
                image-fit: contain;
                vertical-alignment: center;
            }

            Text {


                font-family: "Inter";
                text: root.app-name;
                color: Theme.text-main;
                font-size: 22px;
                font-weight: 750;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        Text {


            font-family: "Inter";
            text: root.description;
            color: Theme.text-muted;
            font-size: 15px;
            font-weight: 450;
            height: 28px;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalLayout {
            height: 36px;
            alignment: end;

            Rectangle {
                width: root.installed ? 124px : 138px;
                height: 36px;
                border-radius: 18px;
                background: root.installed ? Theme.status-installed : Theme.status-not-installed;
                border-width: root.installed ? 0px : 1px;
                border-color: Theme.card-border;

                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 6px;
                    alignment: center;
                    Image {
                        source: root.installed
                            ? @image-url("../assets/icons/status-installed.svg")
                            : @image-url("../assets/icons/status-available.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: root.installed ? #ffffff : Theme.status-not-installed-text;
                        vertical-alignment: center;
                    }
                    Text {

                        font-family: "Inter";
                        text: root.installed ? "Instalado" : "Não instalado";
                        color: root.installed ? #ffffff : Theme.status-not-installed-text;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.activated(
                root.app-name,
                root.description,
                root.app-icon,
                root.installed,
                root.category-name,
                root.version,
                root.developer,
                root.source,
                root.has-update
            );
        }
    }
}

component AppCategory inherits VerticalLayout {
    in property <string> category-title;
    in property <[AppInfo]> apps;
    in property <string> selected-app;
    callback app-selected(string, string, image, bool, string, string, string, string, bool);

    spacing: 17px;

    Text {


        font-family: "Inter";
        text: root.category-title;
        color: Theme.text-main;
        font-size: 26px;
        font-weight: 750;
        height: 31px;
        vertical-alignment: center;
    }

    FlexboxLayout {
        width: 100%;
        flex-direction: row;
        flex-wrap: wrap;
        spacing-horizontal: 20px;
        spacing-vertical: 16px;
        cross-axis-alignment: stretch;

        for app in root.apps: AppCard {
            app-name: app.name;
            description: app.description;
            app-icon: app.icon;
            installed: app.installed;
            highlighted: app.name == root.selected-app;
            category-name: root.category-title;
            version: app.version;
            developer: app.developer;
            source: app.source;
            has-update: app.has_update;
            activated(name, description, icon, installed, category, version, developer, source, has-update) => {
                root.app-selected(name, description, icon, installed, category, version, developer, source, has-update);
            }
        }
    }
}

component DetailTile inherits Rectangle {
    in property <string> tile-label;
    in property <string> tile-value;

    horizontal-stretch: 1;
    height: 82px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.separator;
    background: Theme.dark-mode ? #071d35 : #f4f9fd;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 11px;
        padding-bottom: 11px;
        alignment: center;
        spacing: 5px;

        Text {
            font-family: "Inter";
            text: root.tile-label;
            color: Theme.text-muted;
            font-size: 12px;
            font-weight: 650;
        }

        Text {
            font-family: "Inter";
            text: root.tile-value;
            color: Theme.text-main;
            font-size: 14px;
            font-weight: 700;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component ModalAction inherits Rectangle {
    in property <string> label;
    in property <string> variant: "secondary";
    callback clicked();

    height: 44px;
    border-radius: 22px;
    border-width: root.variant == "secondary" ? 1px : 0px;
    border-color: Theme.card-border;
    background: root.variant == "primary"
        ? (touch.has-hover ? Theme.accent : Theme.accent-deep)
        : root.variant == "danger"
            ? (touch.has-hover ? #ce4b58 : #a93848)
            : (touch.has-hover ? Theme.card-bg-highlight : Theme.nav-hover);

    Text {
        font-family: "Inter";
        text: root.label;
        color: root.variant == "secondary" ? Theme.text-main : #ffffff;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component AppCatalogPage inherits Rectangle {
    in-out property <string> selected-app: "Steam";
    in-out property <bool> details-open: false;
    in-out property <string> detail-name: "";
    in-out property <string> detail-description: "";
    in-out property <image> detail-icon;
    in-out property <bool> detail-installed: false;
    in-out property <string> detail-category: "";
    in-out property <string> detail-version: "";
    in-out property <string> detail-developer: "";
    in-out property <string> detail-source: "";
    in-out property <bool> detail-has-update: false;
    in-out property <string> detail-action-message: "Ações demonstrativas: o backend ainda não está conectado.";
    callback app-selected(string);

    background: Theme.page-bg;

    ScrollView {
        width: 100%;
        height: 100%;
        content-height: 1200px;
        vertical-scrollbar-policy: as-needed;
        horizontal-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            width: 100%;
            height: 1200px;
            padding-left: 40px;
            padding-right: 56px;
            padding-top: 36px;
            padding-bottom: 38px;
            spacing: 28px;

            VerticalLayout {
                spacing: 8px;
                height: 78px;
                Text {

                    font-family: "Inter";
                    text: "Apps";
                    color: Theme.text-main;
                    font-size: 36px;
                    font-weight: 800;
                    height: 43px;
                }
                Text {

                    font-family: "Inter";
                    text: "Descubra, organize e gerencie seus aplicativos para jogos e criação.";
                    color: Theme.text-muted;
                    font-size: 16px;
                    height: 25px;
                    vertical-alignment: center;
                }
            }

            AppCategory {
                category-title: "Launchers";
                selected-app: root.selected-app;
                apps: [
                    { name: "Steam", description: "Loja e plataforma de jogos para PC.", icon: @image-url("../assets/icons/steam.svg"), version: "Não detectada", developer: "Valve", source: "Não consultada", has_update: false, installed: true },
                    { name: "Lutris", description: "Gerenciador de jogos e plataformas.", icon: @image-url("../assets/icons/lutris.svg"), version: "Não detectada", developer: "Lutris Team", source: "Não consultada", has_update: false, installed: true },
                    { name: "Heroic Games Launcher", description: "Cliente para Epic Games, GOG e Amazon.", icon: @image-url("../assets/icons/heroic.svg"), version: "Não detectada", developer: "Heroic Games Launcher Team", source: "Não consultada", has_update: false, installed: true },
                    { name: "itch.io", description: "Cliente para jogos independentes.", icon: @image-url("../assets/icons/itch.svg"), version: "Não detectada", developer: "itch corp.", source: "Não consultada", has_update: false, installed: true },
                    { name: "Minigalaxy", description: "Cliente leve para jogos da GOG.", icon: @image-url("../assets/icons/minigalaxy.svg"), version: "Não detectada", developer: "Minigalaxy contributors", source: "Não consultada", has_update: false, installed: true },
                    { name: "Bottles", description: "Gerencie ambientes para executar apps e jogos.", icon: @image-url("../assets/icons/bottles.svg"), version: "Não detectada", developer: "Bottles Team", source: "Não consultada", has_update: false, installed: true }
                ];
                app-selected(name, description, icon, installed, category, version, developer, source, has-update) => {
                    root.selected-app = name;
                    root.detail-name = name;
                    root.detail-description = description;
                    root.detail-icon = icon;
                    root.detail-installed = installed;
                    root.detail-category = category;
                    root.detail-version = version;
                    root.detail-developer = developer;
                    root.detail-source = source;
                    root.detail-has-update = has-update;
                    root.detail-action-message = "Ações demonstrativas: nenhum comando do sistema é executado.";
                    root.details-open = true;
                    root.app-selected(name);
                }
            }

            AppCategory {
                category-title: "Emuladores";
                selected-app: root.selected-app;
                apps: [
                    { name: "RetroArch", description: "Interface unificada para emuladores.", icon: @image-url("../assets/icons/retroarch.svg"), version: "Não detectada", developer: "Libretro", source: "Não consultada", has_update: false, installed: true },
                    { name: "Dolphin", description: "Emulador de GameCube e Wii.", icon: @image-url("../assets/icons/dolphin.svg"), version: "Não detectada", developer: "Dolphin Emulator Project", source: "Não consultada", has_update: false, installed: false },
                    { name: "PCSX2", description: "Emulador de PlayStation 2.", icon: @image-url("../assets/icons/pcsx2.svg"), version: "Não detectada", developer: "PCSX2 Team", source: "Não consultada", has_update: false, installed: false },
                    { name: "RPCS3", description: "Emulador de PlayStation 3.", icon: @image-url("../assets/icons/rpcs3.svg"), version: "Não detectada", developer: "RPCS3 Team", source: "Não consultada", has_update: false, installed: true },
                    { name: "PPSSPP", description: "Emulador de PSP.", icon: @image-url("../assets/icons/ppsspp.svg"), version: "Não detectada", developer: "PPSSPP Team", source: "Não consultada", has_update: false, installed: true },
                    { name: "DuckStation", description: "Emulador de PlayStation 1.", icon: @image-url("../assets/icons/duckstation.svg"), version: "Não detectada", developer: "DuckStation contributors", source: "Não consultada", has_update: false, installed: false },
                    { name: "mGBA", description: "Emulador de Game Boy Advance.", icon: @image-url("../assets/icons/mgba.svg"), version: "Não detectada", developer: "mGBA Team", source: "Não consultada", has_update: false, installed: true },
                    { name: "MAME", description: "Emulador de máquinas de arcade.", icon: @image-url("../assets/icons/mame.svg"), version: "Não detectada", developer: "MAME Team", source: "Não consultada", has_update: false, installed: true }
                ];
                app-selected(name, description, icon, installed, category, version, developer, source, has-update) => {
                    root.selected-app = name;
                    root.detail-name = name;
                    root.detail-description = description;
                    root.detail-icon = icon;
                    root.detail-installed = installed;
                    root.detail-category = category;
                    root.detail-version = version;
                    root.detail-developer = developer;
                    root.detail-source = source;
                    root.detail-has-update = has-update;
                    root.detail-action-message = "Ações demonstrativas: nenhum comando do sistema é executado.";
                    root.details-open = true;
                    root.app-selected(name);
                }
            }
        }
    }

    if root.details-open: Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(2, 10, 24, 0.74);

        VerticalLayout {
            width: 100%;
            height: 100%;
            alignment: center;

            Rectangle {
                width: 760px;
                height: 620px;
                border-radius: 26px;
                border-width: 1px;
                border-color: Theme.card-border;
                background: Theme.card-bg;
                drop-shadow-offset-x: 0px;
                drop-shadow-offset-y: 16px;
                drop-shadow-blur: 38px;
                drop-shadow-color: rgba(0, 0, 0, 0.46);

                VerticalLayout {
                    padding: 30px;
                    spacing: 15px;

                    HorizontalLayout {
                        height: 86px;
                        spacing: 17px;

                        Image {
                            source: root.detail-icon;
                            width: 76px;
                            height: 76px;
                            image-fit: contain;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 5px;

                            Text {
                                font-family: "Inter";
                                text: root.detail-name;
                                color: Theme.text-main;
                                font-size: 26px;
                                font-weight: 750;
                                vertical-alignment: center;
                            }

                            Text {
                                font-family: "Inter";
                                text: root.detail-category;
                                color: Theme.text-muted;
                                font-size: 14px;
                                font-weight: 650;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 128px;
                            height: 34px;
                            border-radius: 17px;
                            background: root.detail-installed ? Theme.status-installed : Theme.status-not-installed;
                            border-width: root.detail-installed ? 0px : 1px;
                            border-color: Theme.card-border;

                            Text {
                                font-family: "Inter";
                                text: root.detail-installed ? "Instalado" : "Não instalado";
                                color: root.detail-installed ? #ffffff : Theme.status-not-installed-text;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            background: close-touch.has-hover ? Theme.card-bg-highlight : Theme.nav-hover;

                            Text {
                                font-family: "Inter";
                                text: "×";
                                color: Theme.text-main;
                                font-size: 25px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            close-touch := TouchArea {
                                clicked => { root.details-open = false; }
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 1px;
                        background: Theme.separator;
                    }

                    VerticalLayout {
                        spacing: 7px;

                        Text {
                            font-family: "Inter";
                            text: "Sobre o aplicativo";
                            color: Theme.text-main;
                            font-size: 18px;
                            font-weight: 750;
                        }

                        Text {
                            font-family: "Inter";
                            text: root.detail-description;
                            color: Theme.text-muted;
                            font-size: 15px;
                            wrap: word-wrap;
                            height: 48px;
                            vertical-alignment: top;
                        }
                    }

                    HorizontalLayout {
                        height: 82px;
                        spacing: 12px;

                        DetailTile {
                            tile-label: "Versão instalada";
                            tile-value: root.detail-version;
                        }

                        DetailTile {
                            tile-label: "Desenvolvedor";
                            tile-value: root.detail-developer;
                        }

                        DetailTile {
                            tile-label: "Origem";
                            tile-value: root.detail-source;
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 1px;
                        background: Theme.separator;
                    }

                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            font-family: "Inter";
                            text: "Ações";
                            color: Theme.text-main;
                            font-size: 17px;
                            font-weight: 750;
                        }

                        HorizontalLayout {
                            height: 44px;
                            spacing: 10px;

                            if root.detail-installed: ModalAction {
                                width: 132px;
                                label: "Abrir";
                                variant: "primary";
                                clicked => {
                                    root.detail-action-message = "Abrir: integração com o backend ainda pendente.";
                                }
                            }

                            if root.detail-installed && root.detail-has-update: ModalAction {
                                width: 138px;
                                label: "Atualizar";
                                variant: "secondary";
                                clicked => {
                                    root.detail-action-message = "Atualizar: a verificação de versões ainda não está conectada.";
                                }
                            }

                            if root.detail-installed: ModalAction {
                                width: 132px;
                                label: "Remover";
                                variant: "danger";
                                clicked => {
                                    root.detail-action-message = "Remover: nenhum comando foi executado; falta integrar o gerenciador de pacotes.";
                                }
                            }

                            if !root.detail-installed: ModalAction {
                                width: 160px;
                                label: "Escolher fonte";
                                variant: "secondary";
                                clicked => {
                                    root.detail-action-message = "As fontes disponíveis serão listadas quando a detecção do sistema for integrada.";
                                }
                            }

                            if !root.detail-installed: ModalAction {
                                width: 132px;
                                label: "Instalar";
                                variant: "primary";
                                clicked => {
                                    root.detail-action-message = "Instalar: nenhum comando foi executado; falta integrar o gerenciador de pacotes.";
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: #00000000;
                            }

                            ModalAction {
                                width: 118px;
                                label: "Fechar";
                                variant: "secondary";
                                clicked => { root.details-open = false; }
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 42px;
                        border-radius: 12px;
                        background: Theme.dark-mode ? #071a30 : #f0f7fc;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                font-family: "Inter";
                                text: "i";
                                color: Theme.accent;
                                font-size: 15px;
                                font-weight: 800;
                            }

                            Text {
                                font-family: "Inter";
                                text: root.detail-action-message;
                                color: Theme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}

component PlaceholderPage inherits Rectangle {
    in property <string> page-title;
    background: Theme.page-bg;

    VerticalLayout {
        padding: 42px;
        spacing: 12px;
        Text {

            font-family: "Inter";
            text: root.page-title;
            color: Theme.text-main;
            font-size: 36px;
            font-weight: 800;
        }
        Text {

            font-family: "Inter";
            text: "Esta seção faz parte da estrutura visual do Gamefic. Os recursos e integrações serão implementados em etapas próprias.";
            color: Theme.text-muted;
            font-size: 16px;
            wrap: word-wrap;
            max-width: 760px;
        }
    }
}

export component MainWindow inherits Window {
    title: "Gamefic";
    width: 2048px;
    height: 1098px;
    background: Theme.window-bg;

    in-out property <int> active-navigation: 0;
    in-out property <string> selected-app: "Steam";
    property <string> page-title: root.active-navigation == 1 ? "Criação de Conteúdo"
        : root.active-navigation == 2 ? "Monitorado"
        : root.active-navigation == 3 ? "Kernels e Drivers"
        : root.active-navigation == 4 ? "Otimização"
        : root.active-navigation == 5 ? "Overlay"
        : root.active-navigation == 7 ? "Atualizações"
        : root.active-navigation == 8 ? "Fontes de instalação"
        : "Histórico e Diagnósticos";

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        Sidebar {
            width: 256px;
            active-navigation: root.active-navigation;
            navigation-selected(index) => { root.active-navigation = index; }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            TopBar {
                height: 68px;
                theme-toggle => { Theme.dark-mode = !Theme.dark-mode; }
                sources-clicked => { root.active-navigation = 8; }
                updates-clicked => { root.active-navigation = 7; }
            }

            if root.active-navigation == 0: AppCatalogPage {
                vertical-stretch: 1;
                selected-app: root.selected-app;
                app-selected(name) => { root.selected-app = name; }
            }

            if root.active-navigation != 0: PlaceholderPage {
                vertical-stretch: 1;
                page-title: root.page-title;
            }
        }
    }
}
